// --- TAB 1: THEOREM VISUALIZER ---
const TheoremVisualizer = () => {
    const [t, setT] = useState(0.5);

    const A = { x: 250, y: 50 };
    const B = { x: 50, y: 350 };
    const C = { x: 450, y: 350 };

    const D = { x: A.x + t * (B.x - A.x), y: A.y + t * (B.y - A.y) };
    const E = { x: A.x + t * (C.x - A.x), y: A.y + t * (C.y - A.y) };

    const dist = (p1, p2) => Math.sqrt(Math.pow(p2.x - p1.x, 2) + Math.pow(p2.y - p1.y, 2));

    const scale = 10;
    const lenAB = dist(A, B) / scale;
    const lenAC = dist(A, C) / scale;
    const lenBC = dist(B, C) / scale;

    const lenAD = dist(A, D) / scale;
    const lenAE = dist(A, E) / scale;
    const lenDE = dist(D, E) / scale;

    return (
        <div className="p-6 md:p-8">
            <div className="grid md:grid-cols-2 gap-8 items-center">
                <div className="relative bg-slate-50 rounded-xl border border-slate-200 flex flex-col items-center p-4">
                    <svg viewBox="0 0 500 400" className="w-full max-w-md drop-shadow-sm">
                        <polygon points={`${A.x},${A.y} ${B.x},${B.y} ${C.x},${C.y}`} fill="#eff6ff" stroke="#3b82f6" strokeWidth="2" />
                        <line x1={D.x - 20} y1={D.y} x2={E.x + 20} y2={E.y} stroke="#10b981" strokeWidth="3" strokeDasharray="6,4" />
                        <polygon points={`${A.x},${A.y} ${D.x},${D.y} ${E.x},${E.y}`} fill="#d1fae5" fillOpacity="0.6" />

                        <circle cx={A.x} cy={A.y} r="5" fill="#1e3a8a" />
                        <text x={A.x} y={A.y - 12} fontSize="18" fontWeight="bold" textAnchor="middle" fill="#1e3a8a">A</text>

                        <circle cx={B.x} cy={B.y} r="5" fill="#1e3a8a" />
                        <text x={B.x - 15} y={B.y + 10} fontSize="18" fontWeight="bold" textAnchor="middle" fill="#1e3a8a">B</text>

                        <circle cx={C.x} cy={C.y} r="5" fill="#1e3a8a" />
                        <text x={C.x + 15} y={C.y + 10} fontSize="18" fontWeight="bold" textAnchor="middle" fill="#1e3a8a">C</text>

                        <circle cx={D.x} cy={D.y} r="5" fill="#047857" />
                        <text x={D.x - 20} y={D.y + 5} fontSize="18" fontWeight="bold" textAnchor="middle" fill="#047857">D</text>

                        <circle cx={E.x} cy={E.y} r="5" fill="#047857" />
                        <text x={E.x + 20} y={E.y + 5} fontSize="18" fontWeight="bold" textAnchor="middle" fill="#047857">E</text>

                        <path d={`M ${B.x + 180} ${B.y} L ${B.x + 190} ${B.y - 10} L ${B.x + 200} ${B.y}`} fill="none" stroke="#3b82f6" strokeWidth="2" />
                        <path d={`M ${D.x + (E.x - D.x) / 2 - 10} ${D.y} L ${D.x + (E.x - D.x) / 2} ${D.y - 10} L ${D.x + (E.x - D.x) / 2 + 10} ${D.y}`} fill="none" stroke="#10b981" strokeWidth="2" />
                    </svg>

                    <div className="w-full mt-6 bg-white p-4 rounded-lg shadow-sm border border-slate-100">
                        <label className="flex justify-between text-sm font-semibold text-slate-600 mb-2">
                            <span>Move Line DE</span>
                            <span>Position: {Math.round(t * 100)}%</span>
                        </label>
                        <input
                            type="range"
                            min="0.1" max="0.9" step="0.01"
                            value={t}
                            onChange={(e) => setT(parseFloat(e.target.value))}
                            className="w-full accent-emerald-500"
                        />
                    </div>
                </div>

                <div className="flex flex-col space-y-6">
                    <div>
                        <h2 className="text-2xl font-bold text-slate-800 mb-2">Similar Triangles</h2>
                        <p className="text-slate-600">
                            When you draw a line (<strong className="text-emerald-600">DE</strong>) parallel to one side of a triangle (<strong className="text-blue-600">BC</strong>), it creates a smaller triangle (<strong className="text-emerald-600">ADE</strong>) that is <strong>similar</strong> to the original triangle (<strong className="text-blue-600">ABC</strong>).
                        </p>
                    </div>

                    <div className="bg-blue-50 border-l-4 border-blue-500 p-4 rounded-r-lg">
                        <p className="text-sm text-blue-800 font-medium flex items-start gap-2">
                            <Info size={18} className="mt-0.5 flex-shrink-0" />
                            Because they are similar, the ratios of their corresponding sides are always perfectly equal, no matter where the parallel line is placed!
                        </p>
                    </div>

                    <div className="bg-slate-900 rounded-xl p-5 text-slate-200 font-mono text-sm sm:text-base shadow-inner">
                        <div className="grid grid-cols-3 gap-4 mb-4 text-center pb-4 border-b border-slate-700">
                            <div>
                                <div className="text-slate-400 mb-1">Left Side</div>
                                <div className="text-emerald-400">AD = {lenAD.toFixed(1)}</div>
                                <div className="text-blue-400 border-t border-slate-600 pt-1 mt-1">AB = {lenAB.toFixed(1)}</div>
                            </div>
                            <div>
                                <div className="text-slate-400 mb-1">Right Side</div>
                                <div className="text-emerald-400">AE = {lenAE.toFixed(1)}</div>
                                <div className="text-blue-400 border-t border-slate-600 pt-1 mt-1">AC = {lenAC.toFixed(1)}</div>
                            </div>
                            <div>
                                <div className="text-slate-400 mb-1">Bottom Base</div>
                                <div className="text-emerald-400">DE = {lenDE.toFixed(1)}</div>
                                <div className="text-blue-400 border-t border-slate-600 pt-1 mt-1">BC = {lenBC.toFixed(1)}</div>
                            </div>
                        </div>

                        <div className="text-center font-bold text-lg text-white bg-slate-800 py-3 rounded-lg flex justify-center items-center gap-4">
                            <span className="flex flex-col items-center">
                                <span>{lenAD.toFixed(1)}</span>
                                <span className="w-12 h-px bg-slate-400 my-0.5"></span>
                                <span>{lenAB.toFixed(1)}</span>
                            </span>
                            <span>=</span>
                            <span className="flex flex-col items-center">
                                <span>{lenAE.toFixed(1)}</span>
                                <span className="w-12 h-px bg-slate-400 my-0.5"></span>
                                <span>{lenAC.toFixed(1)}</span>
                            </span>
                            <span>=</span>
                            <span className="flex flex-col items-center">
                                <span>{lenDE.toFixed(1)}</span>
                                <span className="w-12 h-px bg-slate-400 my-0.5"></span>
                                <span>{lenBC.toFixed(1)}</span>
                            </span>
                            <span className="ml-2 text-emerald-400">
                                ≈ {(lenAD / lenAB).toFixed(2)}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};


// --- TAB 2: PYRAMID SIMULATOR ---
const PyramidSimulator = () => {
    const [sunAngleDeg, setSunAngleDeg] = useState(60);

    const groundY = 320;
    const H_pyramid = 146;
    const W_pyramid = 230;
    const P_center = 250;

    const h_stick = 30;
    const S_center = 600;

    const sunAngleRad = (sunAngleDeg * Math.PI) / 180;

    const shadow_pyramid = H_pyramid / Math.tan(sunAngleRad);
    const shadow_stick = h_stick / Math.tan(sunAngleRad);

    const isMagicMoment = Math.abs(sunAngleDeg - 45) < 0.5;

    return (
        <div className="p-0">
            <div className="relative w-full h-[450px] bg-gradient-to-b from-sky-300 to-sky-100 overflow-hidden">

                <div className={`absolute top-4 left-0 right-0 mx-auto w-max px-6 py-2 rounded-full font-bold shadow-lg transition-all duration-500 z-10 ${isMagicMoment
                    ? 'bg-amber-400 text-slate-900 scale-100 opacity-100'
                    : 'bg-white opacity-0 scale-90 pointer-events-none'
                    }`}>
                    ✨ The Magic Moment! Shadow equals Height. ✨
                </div>

                <svg viewBox="0 0 800 450" className="w-full h-full preserve-3d">
                    <g transform={`translate(${P_center + 150}, ${groundY - H_pyramid - 150 * Math.tan(sunAngleRad)})`}>
                        <circle cx="0" cy="0" r="25" fill="#fcd34d" className="animate-pulse" />
                        <circle cx="0" cy="0" r="35" fill="#fef3c7" opacity="0.4" />
                    </g>

                    <rect x="0" y={groundY} width="800" height="130" fill="#eab308" opacity="0.2" />
                    <line x1="0" y1={groundY} x2="800" y2={groundY} stroke="#b45309" strokeWidth="2" />

                    {shadow_pyramid > (W_pyramid / 2) && (
                        <polygon
                            points={`
                ${P_center + W_pyramid / 2},${groundY} 
                ${P_center + shadow_pyramid},${groundY} 
                ${P_center + shadow_pyramid - 20},${groundY + 15}
                ${P_center + W_pyramid / 2 - 20},${groundY + 15}
              `}
                            fill="#000" opacity="0.15"
                        />
                    )}

                    <polygon
                        points={`
              ${P_center - W_pyramid / 2},${groundY} 
              ${P_center},${groundY - H_pyramid} 
              ${P_center + W_pyramid / 2},${groundY}
            `}
                        fill="#d97706"
                    />
                    <polygon
                        points={`
              ${P_center},${groundY - H_pyramid} 
              ${P_center + W_pyramid / 2},${groundY}
              ${P_center},${groundY}
            `}
                        fill="#b45309"
                    />
                    <line x1={P_center} y1={groundY} x2={P_center} y2={groundY - H_pyramid} stroke="#fff" strokeDasharray="4,4" strokeWidth="1.5" />

                    <line
                        x1={P_center} y1={groundY - H_pyramid}
                        x2={P_center + shadow_pyramid} y2={groundY}
                        stroke="#fbbf24" strokeWidth="2" strokeDasharray="6,4"
                    />

                    <line
                        x1={S_center} y1={groundY}
                        x2={S_center + shadow_stick} y2={groundY}
                        stroke="#000" strokeWidth="6" opacity="0.3"
                    />
                    <line
                        x1={S_center} y1={groundY}
                        x2={S_center} y2={groundY - h_stick}
                        stroke="#451a03" strokeWidth="4" strokeLinecap="round"
                    />
                    <line
                        x1={S_center} y1={groundY - h_stick}
                        x2={S_center + shadow_stick} y2={groundY}
                        stroke="#fbbf24" strokeWidth="2" strokeDasharray="6,4"
                    />

                    <text x={P_center - 25} y={groundY - H_pyramid / 2} fill="#fff" fontSize="14" fontWeight="bold">H = ?</text>

                    <path d={`M ${P_center} ${groundY + 25} L ${P_center + shadow_pyramid} ${groundY + 25}`} stroke="#78350f" strokeWidth="1" markerEnd="url(#arrow)" markerStart="url(#arrow)" />
                    <text x={P_center + shadow_pyramid / 2} y={groundY + 45} fill="#78350f" fontSize="14" fontWeight="bold" textAnchor="middle">S = {shadow_pyramid.toFixed(1)}m</text>

                    <text x={S_center - 15} y={groundY - h_stick / 2 + 5} fill="#451a03" fontSize="14" fontWeight="bold" textAnchor="end">h = {h_stick}m</text>

                    <path d={`M ${S_center} ${groundY + 25} L ${S_center + shadow_stick} ${groundY + 25}`} stroke="#78350f" strokeWidth="1" markerEnd="url(#arrow)" markerStart="url(#arrow)" />
                    <text x={S_center + shadow_stick / 2} y={groundY + 45} fill="#78350f" fontSize="14" fontWeight="bold" textAnchor="middle">s = {shadow_stick.toFixed(1)}m</text>

                    <defs>
                        <marker id="arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                            <path d="M 0 0 L 10 5 L 0 10 z" fill="#78350f" />
                        </marker>
                    </defs>
                </svg>

                <div className="absolute bottom-6 left-6 right-6 md:left-auto md:w-80 bg-white/90 backdrop-blur p-4 rounded-xl shadow-xl border border-white/50">
                    <label className="flex items-center gap-2 font-bold text-slate-700 mb-3">
                        <Sun size={20} className="text-amber-500" />
                        Time of Day (Sun Angle)
                    </label>
                    <input
                        type="range"
                        min="25" max="75" step="0.1"
                        value={sunAngleDeg}
                        onChange={(e) => setSunAngleDeg(parseFloat(e.target.value))}
                        className="w-full accent-amber-500"
                    />
                    <div className="flex justify-between text-xs text-slate-500 mt-1 font-medium">
                        <span>Late Afternoon</span>
                        <span>Angle: {sunAngleDeg.toFixed(1)}°</span>
                        <span>Midday</span>
                    </div>
                    <div className="mt-4 pt-3 border-t border-slate-200">
                        <button
                            onClick={() => setSunAngleDeg(45)}
                            className="w-full py-2 bg-amber-100 hover:bg-amber-200 text-amber-800 font-semibold rounded-lg transition-colors text-sm"
                        >
                            Set to 45° (Thales's Trick)
                        </button>
                    </div>
                </div>
            </div>

            <div className="p-6 md:p-8 grid md:grid-cols-2 gap-8 bg-white">
                <div>
                    <h2 className="text-2xl font-bold text-slate-800 mb-3">How Thales Measured the Pyramid</h2>
                    <p className="text-slate-600 mb-4 leading-relaxed">
                        Thales realized that the sun's rays are parallel, meaning the pyramid and its shadow form a triangle that is perfectly <strong>similar</strong> to the triangle formed by a small stick and its shadow.
                    </p>
                    <p className="text-slate-600 leading-relaxed">
                        Because the triangles are similar, the ratio of the height to the shadow length is the exact same for both objects.
                    </p>
                </div>

                <div className="bg-amber-50 border border-amber-200 rounded-xl p-5 flex flex-col justify-center">
                    <div className="flex items-center justify-center gap-6 text-xl font-bold text-slate-800 mb-4">
                        <div className="flex flex-col items-center">
                            <span className="text-amber-700">Height (H)</span>
                            <div className="h-px w-full bg-slate-400 my-1"></div>
                            <span>Shadow (S)</span>
                        </div>
                        <span>=</span>
                        <div className="flex flex-col items-center">
                            <span className="text-amber-700">Stick (h)</span>
                            <div className="h-px w-full bg-slate-400 my-1"></div>
                            <span>Shadow (s)</span>
                        </div>
                    </div>

                    <div className="text-center font-mono bg-white p-3 rounded-lg border border-amber-100 shadow-sm">
                        <span className={isMagicMoment ? 'text-amber-600 font-bold scale-110 inline-block transition-transform' : 'text-slate-600 transition-transform'}>
                            H = S × (h / s)
                        </span>
                        <br />
                        <span className="text-slate-500 text-sm mt-2 inline-block">
                            H = {shadow_pyramid.toFixed(1)} × ({h_stick} / {shadow_stick.toFixed(1)}) = <strong>{Math.round(shadow_pyramid * (h_stick / shadow_stick))}m</strong>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    );
};


// --- TAB 3: SHIP SIMULATOR ---
const ShipSimulator = () => {
    // Simulator State
    const [shipDist, setShipDist] = useState(200); // Distance AS (Ship to shore point A)
    const [baseAB, setBaseAB] = useState(150);     // Distance AB (First leg on shore)

    // Constants for the visual layout
    const baseBC = 60; // Fixed small leg on shore
    const shoreY = 250; // Y coordinate of the shoreline
    const startX = 120; // X coordinate of point A

    // Calculated geometry
    const distCD = shipDist * (baseBC / baseAB); // The length the observer must walk inland

    // SVG Coordinates
    const A = { x: startX, y: shoreY };
    const B = { x: startX + baseAB, y: shoreY };
    const C = { x: startX + baseAB + baseBC, y: shoreY };
    const S = { x: startX, y: shoreY - shipDist };
    const D = { x: startX + baseAB + baseBC, y: shoreY + distCD };

    return (
        <div className="p-0">
            {/* Simulation Area */}
            <div className="relative w-full h-[450px] bg-sky-50 overflow-hidden">

                <svg viewBox="0 0 800 450" className="w-full h-full">
                    {/* Water Area */}
                    <rect x="0" y="0" width="800" height={shoreY} fill="#bae6fd" />

                    {/* Land Area */}
                    <rect x="0" y={shoreY} width="800" height={450 - shoreY} fill="#fef08a" opacity="0.6" />
                    <line x1="0" y1={shoreY} x2="800" y2={shoreY} stroke="#d97706" strokeWidth="4" />

                    {/* Sea Triangle (A-B-S) */}
                    <polygon
                        points={`${A.x},${A.y} ${B.x},${B.y} ${S.x},${S.y}`}
                        fill="#3b82f6" fillOpacity="0.15" stroke="#2563eb" strokeWidth="2" strokeDasharray="4,4"
                    />

                    {/* Land Triangle (C-B-D) */}
                    <polygon
                        points={`${C.x},${C.y} ${B.x},${B.y} ${D.x},${D.y}`}
                        fill="#10b981" fillOpacity="0.25" stroke="#059669" strokeWidth="2" strokeDasharray="4,4"
                    />

                    {/* Right Angle Indicators */}
                    <polyline points={`${A.x},${A.y - 12} ${A.x + 12},${A.y - 12} ${A.x + 12},${A.y}`} fill="none" stroke="#64748b" strokeWidth="1.5" />
                    <polyline points={`${C.x},${C.y + 12} ${C.x - 12},${C.y + 12} ${C.x - 12},${C.y}`} fill="none" stroke="#64748b" strokeWidth="1.5" />

                    {/* Line of Sight (S -> D through B) */}
                    <line
                        x1={S.x} y1={S.y}
                        x2={D.x} y2={D.y}
                        stroke="#ef4444" strokeWidth="2" opacity="0.6" strokeDasharray="8,4"
                    />

                    {/* Points & Labels */}
                    <g>
                        <circle cx={A.x} cy={A.y} r="5" fill="#1e293b" />
                        <text x={A.x - 15} y={A.y + 20} fontSize="14" fontWeight="bold" fill="#1e293b">A</text>
                        <text x={A.x + baseAB / 2} y={A.y - 10} fontSize="14" fill="#1e293b" textAnchor="middle">Shoreline Baseline (AB)</text>

                        <circle cx={B.x} cy={B.y} r="5" fill="#1e293b" />
                        <text x={B.x} y={A.y - 10} fontSize="14" fontWeight="bold" fill="#1e293b" textAnchor="middle">B</text>

                        <circle cx={C.x} cy={C.y} r="5" fill="#1e293b" />
                        <text x={C.x + 15} y={A.y - 10} fontSize="14" fontWeight="bold" fill="#1e293b">C</text>
                        <text x={B.x + baseBC / 2} y={A.y + 20} fontSize="12" fill="#1e293b" textAnchor="middle">BC = {baseBC}m</text>

                        <circle cx={D.x} cy={D.y} r="5" fill="#059669" />
                        <text x={D.x + 15} y={D.y + 5} fontSize="14" fontWeight="bold" fill="#059669">D (Observer)</text>
                    </g>

                    {/* Measurement Dimensions */}
                    <path d={`M ${A.x - 20} ${S.y} L ${A.x - 20} ${A.y}`} stroke="#2563eb" strokeWidth="1.5" markerEnd="url(#arrow-blue)" markerStart="url(#arrow-blue)" />
                    <text x={A.x - 30} y={A.y - shipDist / 2} fontSize="14" fontWeight="bold" fill="#2563eb" transform={`rotate(-90 ${A.x - 30} ${A.y - shipDist / 2})`} textAnchor="middle">Target Distance (AS) = {shipDist}m</text>

                    <path d={`M ${C.x + 20} ${C.y} L ${C.x + 20} ${D.y}`} stroke="#059669" strokeWidth="1.5" markerEnd="url(#arrow-green)" markerStart="url(#arrow-green)" />
                    <text x={C.x + 30} y={C.y + distCD / 2} fontSize="14" fontWeight="bold" fill="#059669" transform={`rotate(90 ${C.x + 30} ${C.y + distCD / 2})`} textAnchor="middle">Measured (CD) = {distCD.toFixed(1)}m</text>

                    {/* The Ship (at Point S) */}
                    <g transform={`translate(${S.x}, ${S.y})`}>
                        {/* Simple Sailboat SVG */}
                        <path d="M -20 -5 L 20 -5 L 12 10 L -12 10 Z" fill="#475569" />
                        <path d="M 0 -5 L 0 -30 L 15 -10 Z" fill="#f8fafc" stroke="#cbd5e1" />
                        <text x="25" y="-10" fontSize="14" fontWeight="bold" fill="#1e293b">S (Enemy Ship)</text>
                    </g>

                    {/* Definition for arrows */}
                    <defs>
                        <marker id="arrow-blue" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                            <path d="M 0 0 L 10 5 L 0 10 z" fill="#2563eb" />
                        </marker>
                        <marker id="arrow-green" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                            <path d="M 0 0 L 10 5 L 0 10 z" fill="#059669" />
                        </marker>
                    </defs>
                </svg>

                {/* Controls */}
                <div className="absolute top-6 right-6 w-80 bg-white/90 backdrop-blur p-5 rounded-xl shadow-xl border border-white/50">
                    <h3 className="font-bold text-slate-800 mb-4 flex items-center gap-2">
                        <Anchor size={18} className="text-emerald-600" /> Adjust Variables
                    </h3>

                    <div className="mb-4">
                        <label className="flex justify-between text-xs font-semibold text-slate-600 mb-2">
                            <span>Actual Ship Distance (AS)</span>
                            <span className="text-blue-600">{shipDist}m</span>
                        </label>
                        <input
                            type="range" min="100" max="230" step="1"
                            value={shipDist} onChange={(e) => setShipDist(parseInt(e.target.value))}
                            className="w-full accent-blue-500"
                        />
                    </div>

                    <div>
                        <label className="flex justify-between text-xs font-semibold text-slate-600 mb-2">
                            <span>Walk along shore (AB)</span>
                            <span className="text-slate-800">{baseAB}m</span>
                        </label>
                        <input
                            type="range" min="80" max="250" step="1"
                            value={baseAB} onChange={(e) => setBaseAB(parseInt(e.target.value))}
                            className="w-full accent-slate-600"
                        />
                    </div>
                </div>
            </div>

            {/* Explanation Section */}
            <div className="p-6 md:p-8 grid md:grid-cols-2 gap-8 bg-white">
                <div>
                    <h2 className="text-2xl font-bold text-slate-800 mb-3">Measuring the Unreachable</h2>
                    <p className="text-slate-600 mb-4 leading-relaxed">
                        To find the distance to an enemy ship (<strong className="text-blue-600">AS</strong>) without getting wet, an engineer could stand at <strong className="text-slate-800">A</strong>, walk a set distance down the beach to place a peg at <strong className="text-slate-800">B</strong>, and then walk a little further to <strong className="text-slate-800">C</strong>.
                    </p>
                    <p className="text-slate-600 leading-relaxed">
                        By walking directly inland to point <strong className="text-emerald-600">D</strong> until the peg at <strong className="text-slate-800">B</strong> perfectly covered the ship <strong className="text-slate-800">S</strong>, they created two <strong>similar triangles</strong> meeting at the peg.
                    </p>
                </div>

                <div className="bg-emerald-50 border border-emerald-200 rounded-xl p-5 flex flex-col justify-center">
                    <div className="flex items-center justify-center gap-6 text-xl font-bold text-slate-800 mb-4">
                        <div className="flex flex-col items-center">
                            <span className="text-blue-600">Ship Dist (AS)</span>
                            <div className="h-px w-full bg-slate-400 my-1"></div>
                            <span>Shore (AB)</span>
                        </div>
                        <span>=</span>
                        <div className="flex flex-col items-center">
                            <span className="text-emerald-600">Inland (CD)</span>
                            <div className="h-px w-full bg-slate-400 my-1"></div>
                            <span>Shore (BC)</span>
                        </div>
                    </div>

                    <div className="text-center font-mono bg-white p-4 rounded-lg border border-emerald-100 shadow-sm">
                        <span className="text-emerald-700 font-bold text-lg">
                            AS = AB × (CD / BC)
                        </span>
                        <div className="text-slate-500 text-sm mt-3 pt-3 border-t border-emerald-50">
                            The observer only needs to measure their short inland walk (<strong className="text-emerald-600">{distCD.toFixed(1)}m</strong>) to instantly calculate that the ship is <strong>{shipDist}m</strong> away!
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};

export default App;