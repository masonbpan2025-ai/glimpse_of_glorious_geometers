import React, { useState, useEffect, useRef } from 'react';
import { Music, Activity, Volume2, Info, Home, AlertTriangle, ArrowRight } from 'lucide-react';

// Organized note data mapped to the Pythagorean spiral formulas
const notes = [
    // 1. The Major Scale (Foundations starting from F)
    { note: "F", name: "Perfect 4th", m: -1, n: -1, num: 4, den: 3, category: "white" },
    { note: "C", name: "Root (Home)", m: 0, n: 0, num: 1, den: 1, isHome: true, category: "white" },
    { note: "G", name: "Perfect 5th", m: 1, n: 0, num: 3, den: 2, category: "white" },
    { note: "D", name: "Major 2nd", m: 2, n: 1, num: 9, den: 8, category: "white" },
    { note: "A", name: "Major 6th", m: 3, n: 1, num: 27, den: 16, category: "white" },
    { note: "E", name: "Major 3rd", m: 4, n: 2, num: 81, den: 64, category: "white" },
    { note: "B", name: "Major 7th", m: 5, n: 2, num: 243, den: 128, category: "white" },

    // 2. The Upward Spiral (Generating the Sharps)
    { note: "F#", name: "Augmented 4th", m: 6, n: 3, num: 729, den: 512, category: "sharp" },
    { note: "C#", name: "Minor 2nd", m: 7, n: 4, num: 2187, den: 2048, category: "sharp" },
    { note: "G#", name: "Minor 6th", m: 8, n: 4, num: 6561, den: 4096, category: "sharp" },
    { note: "D#", name: "Minor 3rd", m: 9, n: 5, num: 19683, den: 16384, category: "sharp" },
    { note: "A#", name: "Minor 7th", m: 10, n: 5, num: 59049, den: 32768, category: "sharp" },
    { note: "E#", name: "Major 3rd", m: 11, n: 6, num: 177147, den: 131072, category: "sharp" },

    // 3. The 12th Fifth vs The True Octave
    { note: "C' (True Octave)", name: "Perfect 2.0x Multiplier", m: 0, n: -1, num: 2, den: 1, category: "comma", isPerfect: true },
    { note: "B# (~C')", name: "The 12th Fifth", m: 12, n: 6, num: 531441, den: 262144, category: "comma", isComma: true }
];

export default function App() {
    const [activeIndex, setActiveIndex] = useState(1); // Default to C (Home)
    const [soundEnabled, setSoundEnabled] = useState(false);

    const activePathRef = useRef(null);
    const audioCtxRef = useRef(null);

    const activeNote = notes[activeIndex];
    const lengthPct = activeNote.den / activeNote.num;
    const freqRatio = activeNote.num / activeNote.den;

    // Handle Animation Loop
    useEffect(() => {
        let animationFrameId;
        let t = 0;

        const renderLoop = () => {
            t += 0.08 * freqRatio;
            const amplitude = 12 * Math.sin(t);

            const midX = 100 * lengthPct / 2;
            const endX = 100 * lengthPct;

            const pathString = `M 0 50 Q ${midX} ${50 + amplitude} ${endX} 50`;

            if (activePathRef.current) {
                activePathRef.current.setAttribute('d', pathString);
            }

            animationFrameId = requestAnimationFrame(renderLoop);
        };

        renderLoop();
        return () => cancelAnimationFrame(animationFrameId);
    }, [freqRatio, lengthPct]);

    // Handle Web Audio API
    const playTone = (ratio) => {
        if (!soundEnabled) return;

        if (!audioCtxRef.current) {
            audioCtxRef.current = new (window.AudioContext || window.webkitAudioContext)();
        }

        const ctx = audioCtxRef.current;
        if (ctx.state === 'suspended') ctx.resume();

        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        // Base frequency C4 = 261.63 Hz
        osc.frequency.value = 261.63 * ratio;
        osc.type = 'sine';

        osc.connect(gain);
        gain.connect(ctx.destination);

        osc.start();
        gain.gain.setValueAtTime(0.5, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 1.5);
        osc.stop(ctx.currentTime + 1.5);
    };

    const handleNoteSelect = (index, ratio) => {
        setActiveIndex(index);
        playTone(ratio);
    };

    // Helper for dynamic font sizing for large numbers
    const getFractionTextSize = (numStr) => {
        const len = numStr.toString().length;
        if (len >= 5) return 'text-2xl md:text-3xl';
        if (len >= 3) return 'text-3xl md:text-4xl';
        return 'text-5xl';
    };

    return (
        <div className="min-h-screen bg-slate-950 text-slate-200 font-sans p-4 md:p-8 selection:bg-cyan-900 pb-20">
            <div className="max-w-5xl mx-auto space-y-6">

                {/* Header */}
                <header className="space-y-4">
                    <div className="flex items-center justify-between">
                        <div>
                            <h1 className="text-3xl md:text-4xl font-light tracking-tight text-white mb-2">
                                Pythagorean <span className="font-bold text-amber-500">Sharps</span>
                            </h1>
                            <p className="text-slate-400 max-w-3xl text-sm md:text-base leading-relaxed">
                                Exploring what happens when you continue the chain of Perfect Fifths past the major scale.
                                Watch how the fractions explode in complexity, culminating in the 12th iteration: the Pythagorean Comma.
                            </p>
                        </div>
                        <button
                            onClick={() => setSoundEnabled(!soundEnabled)}
                            className={`hidden md:flex items-center shrink-0 gap-2 px-4 py-2 rounded-full border transition-all ${soundEnabled
                                ? 'bg-amber-500/10 border-amber-500 text-amber-400'
                                : 'bg-slate-900 border-slate-700 text-slate-500 hover:text-slate-300'
                                }`}
                        >
                            <Volume2 size={18} />
                            {soundEnabled ? 'Sound On' : 'Sound Off'}
                        </button>
                    </div>
                </header>

                {/* Monochord Visualizer */}
                <div className="bg-slate-900 border border-slate-800 rounded-3xl p-6 md:p-8 shadow-2xl relative overflow-hidden">
                    <div className="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-amber-500 via-rose-500 to-purple-600 opacity-20"></div>

                    <div className="flex items-center justify-between mb-6 text-slate-400 uppercase tracking-widest text-xs font-semibold">
                        <span>Nut (Fixed)</span>
                        <span>Bridge (Movable)</span>
                    </div>

                    <div className="relative w-full h-32 md:h-40 bg-slate-950/50 rounded-xl border border-slate-800/50 shadow-inner flex items-center">
                        <svg viewBox="0 0 100 100" preserveAspectRatio="none" className="w-full h-full absolute inset-0">
                            {/* Grid / Background lines */}
                            <line x1="0" y1="50" x2="100" y2="50" stroke="#1e293b" strokeWidth="0.5" />
                            <line x1="50" y1="20" x2="50" y2="80" stroke="#1e293b" strokeWidth="0.5" strokeDasharray="1,2" />

                            {/* Inactive portion of string */}
                            <line x1={100 * lengthPct} y1="50" x2="100" y2="50" stroke="#334155" strokeWidth="1.5" strokeLinecap="round" />

                            {/* Active / Vibrating portion of string */}
                            <path
                                ref={activePathRef}
                                d={`M 0 50 Q ${100 * lengthPct / 2} 50 ${100 * lengthPct} 50`}
                                fill="none"
                                stroke={activeNote.isHome ? "#f59e0b" : activeNote.isComma ? "#f43f5e" : activeNote.isPerfect ? "#10b981" : "#22d3ee"}
                                strokeWidth="2.5"
                                strokeLinecap="round"
                                className="transition-all duration-300 ease-out"
                                style={{
                                    filter: `drop-shadow(0 0 6px ${activeNote.isHome ? 'rgba(245, 158, 11, 0.6)' :
                                        activeNote.isComma ? 'rgba(244, 63, 94, 0.6)' :
                                            activeNote.isPerfect ? 'rgba(16, 185, 129, 0.6)' :
                                                'rgba(34, 211, 238, 0.6)'
                                        })`
                                }}
                            />

                            {/* The Bridge (Movable) */}
                            <g className="transition-all duration-500 ease-in-out" style={{ transform: `translateX(${100 * lengthPct}%)` }}>
                                <polygon points="-1.5,60 1.5,60 0,50" fill="#94a3b8" />
                                <line x1="0" y1="20" x2="0" y2="80" stroke="#475569" strokeWidth="0.5" strokeDasharray="2,2" />
                            </g>

                            {/* Endpoints */}
                            <circle cx="0" cy="50" r="1.5" fill="#94a3b8" />
                            <circle cx="100" cy="50" r="1.5" fill="#475569" />
                        </svg>
                    </div>
                </div>

                {/* Note Controls - Grouped by Step */}
                <div className="space-y-6">

                    {/* Group 1: White Keys */}
                    <div className="bg-slate-900/50 p-4 md:p-6 rounded-2xl border border-slate-800">
                        <h3 className="text-sm font-semibold text-slate-400 mb-4 flex items-center gap-2 uppercase tracking-wide">
                            1. The Major Scale <span className="lowercase font-normal text-slate-500">(Starting from F)</span>
                        </h3>
                        <div className="grid grid-cols-3 md:flex md:flex-wrap gap-2 md:gap-3">
                            {notes.map((item, index) => {
                                if (item.category !== 'white') return null;
                                const isActive = index === activeIndex;
                                return (
                                    <button
                                        key={item.note}
                                        onClick={() => handleNoteSelect(index, item.num / item.den)}
                                        className={`relative flex-1 min-w-[70px] md:min-w-[80px] py-3 md:py-4 rounded-xl font-medium transition-all duration-300 border ${isActive
                                            ? item.isHome
                                                ? 'bg-amber-500/20 border-amber-500/50 text-amber-300 shadow-[0_0_15px_rgba(245,158,11,0.2)] transform scale-105 z-10'
                                                : 'bg-cyan-500/20 border-cyan-500/50 text-cyan-300 shadow-[0_0_15px_rgba(34,211,238,0.15)] transform scale-105 z-10'
                                            : item.isHome
                                                ? 'bg-slate-900 border-amber-500/30 text-amber-500/80 hover:bg-slate-800'
                                                : 'bg-slate-900 border-slate-800 text-slate-400 hover:bg-slate-800'
                                            }`}
                                    >
                                        {item.isHome && (
                                            <div className="absolute -top-2 left-1/2 -translate-x-1/2 flex items-center gap-1 text-[8px] md:text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500 text-amber-950">
                                                <Home size={10} /> HOME
                                            </div>
                                        )}
                                        <div className="text-xl md:text-2xl mb-1">{item.note}</div>
                                    </button>
                                );
                            })}
                        </div>
                    </div>

                    {/* Group 2: Sharp Keys */}
                    <div className="bg-slate-900/50 p-4 md:p-6 rounded-2xl border border-slate-800">
                        <h3 className="text-sm font-semibold text-slate-400 mb-4 flex items-center gap-2 uppercase tracking-wide">
                            2. The Upward Spiral <span className="lowercase font-normal text-slate-500">(Generating the Sharps)</span>
                        </h3>
                        <div className="grid grid-cols-3 md:flex md:flex-wrap gap-2 md:gap-3">
                            {notes.map((item, index) => {
                                if (item.category !== 'sharp') return null;
                                const isActive = index === activeIndex;
                                return (
                                    <button
                                        key={item.note}
                                        onClick={() => handleNoteSelect(index, item.num / item.den)}
                                        className={`flex-1 min-w-[70px] md:min-w-[80px] py-3 md:py-4 rounded-xl font-medium transition-all duration-300 border ${isActive
                                            ? 'bg-cyan-500/20 border-cyan-500/50 text-cyan-300 shadow-[0_0_15px_rgba(34,211,238,0.15)] transform scale-105 z-10'
                                            : 'bg-[#0f172a] border-slate-800/80 text-slate-500 hover:bg-slate-800 hover:text-slate-300 shadow-inner'
                                            }`}
                                    >
                                        <div className="text-xl md:text-2xl mb-1">{item.note}</div>
                                    </button>
                                );
                            })}
                        </div>
                    </div>

                    {/* Group 3: The Octave Collision */}
                    <div className="bg-slate-900/50 p-4 md:p-6 rounded-2xl border border-slate-800 relative overflow-hidden">
                        <div className="absolute right-0 top-0 w-64 h-64 bg-rose-500/5 rounded-full blur-3xl pointer-events-none"></div>
                        <h3 className="text-sm font-semibold text-slate-400 mb-4 flex items-center gap-2 uppercase tracking-wide">
                            3. The 12th Fifth vs True Octave <span className="lowercase font-normal text-slate-500">(The Collision)</span>
                        </h3>
                        <div className="flex flex-col sm:flex-row gap-4">
                            {notes.map((item, index) => {
                                if (item.category !== 'comma') return null;
                                const isActive = index === activeIndex;
                                return (
                                    <button
                                        key={item.note}
                                        onClick={() => handleNoteSelect(index, item.num / item.den)}
                                        className={`flex-1 py-4 md:py-6 px-4 rounded-xl font-medium transition-all duration-300 border flex flex-col items-center justify-center ${isActive
                                            ? item.isPerfect
                                                ? 'bg-emerald-500/20 border-emerald-500/50 text-emerald-300 shadow-[0_0_15px_rgba(16,185,129,0.15)] transform scale-[1.02] z-10'
                                                : 'bg-rose-500/20 border-rose-500/50 text-rose-300 shadow-[0_0_15px_rgba(244,63,94,0.15)] transform scale-[1.02] z-10'
                                            : 'bg-slate-900 border-slate-800 text-slate-400 hover:bg-slate-800'
                                            }`}
                                    >
                                        <div className="text-2xl md:text-3xl mb-1">{item.note}</div>
                                        <div className="text-xs opacity-70 mt-1">{item.name}</div>
                                    </button>
                                );
                            })}
                        </div>

                        {activeNote.isComma && (
                            <div className="mt-4 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300/90 text-sm flex items-start gap-3 animate-in fade-in slide-in-from-top-2">
                                <AlertTriangle className="shrink-0 mt-0.5" size={18} />
                                <p>
                                    <strong>The Pythagorean Comma:</strong> You stacked 12 perfect fifths. Mathematically, $B\sharp$ should loop back to exactly $C'$. But $(3/2)^{12} / 2^6$ equals <strong>2.0272</strong>, not a perfect <strong>2.0</strong>! The pitch is slightly sharp. Try clicking between the two buttons above to see the bridge shift and hear the difference.
                                </p>
                            </div>
                        )}
                    </div>

                </div>

                {/* Mathematical Readout (Bottom Row) */}
                <div className="grid md:grid-cols-3 gap-4 md:gap-6 pt-4">

                    <div className="bg-slate-900 p-5 md:p-6 rounded-2xl border border-slate-800 flex flex-col justify-between">
                        <div className="text-slate-500 text-xs md:text-sm font-medium mb-4 flex items-center gap-2 uppercase tracking-wide">
                            <Activity size={16} /> Formula
                        </div>
                        {activeNote.isPerfect ? (
                            <div className="flex items-center justify-center h-20 md:h-24 text-3xl md:text-4xl font-light text-emerald-400">
                                2.0
                            </div>
                        ) : (
                            <div className="flex items-center justify-center h-20 md:h-24 text-2xl md:text-4xl font-serif text-white">
                                <span className="mr-1 md:mr-2">(</span>
                                <div className="flex flex-col items-center justify-center text-xl md:text-2xl mx-1 leading-none">
                                    <span>3</span>
                                    <span className="border-t border-slate-500 w-full my-1"></span>
                                    <span>2</span>
                                </div>
                                <span className="ml-1 md:ml-2">)</span>
                                <sup className="text-sm md:text-lg text-amber-400 ml-1 font-sans">{activeNote.m}</sup>

                                <span className="mx-2 md:mx-4 text-slate-600">/</span>

                                <span className="text-2xl md:text-3xl">2</span>
                                <sup className="text-sm md:text-lg text-blue-400 ml-1 font-sans">{activeNote.n}</sup>
                            </div>
                        )}
                    </div>

                    <div className="bg-slate-900 p-5 md:p-6 rounded-2xl border border-slate-800 flex flex-col justify-between">
                        <div className="text-slate-500 text-xs md:text-sm font-medium mb-4 flex items-center gap-2 uppercase tracking-wide">
                            <Music size={16} /> Freq Ratio
                        </div>
                        <div className="flex flex-col items-center justify-center h-20 md:h-24 w-full overflow-hidden">
                            <div className={`font-light flex items-center gap-2 ${activeNote.isHome ? 'text-amber-400' : activeNote.isComma ? 'text-rose-400' : activeNote.isPerfect ? 'text-emerald-400' : 'text-cyan-400'} ${getFractionTextSize(activeNote.num)}`}>
                                <span>{activeNote.num}</span>
                                <span className="text-slate-600 font-normal">/</span>
                                <span>{activeNote.den}</span>
                            </div>
                            <div className="text-slate-500 mt-2 md:mt-3 font-mono text-xs md:text-sm bg-slate-950 px-2 py-1 rounded">
                                {(activeNote.num / activeNote.den).toFixed(5)}x Hz
                            </div>
                        </div>
                    </div>

                    <div className="bg-slate-900 p-5 md:p-6 rounded-2xl border border-slate-800 relative overflow-hidden flex flex-col justify-between">
                        <div className="absolute top-0 right-0 w-32 h-32 bg-blue-500/5 rounded-full blur-3xl pointer-events-none"></div>
                        <div className="text-slate-500 text-xs md:text-sm font-medium mb-4 uppercase tracking-wide relative z-10">
                            String Length
                        </div>
                        <div className="flex flex-col items-center justify-center h-20 md:h-24 w-full overflow-hidden relative z-10">
                            <div className={`font-light flex items-center gap-2 text-blue-400 ${getFractionTextSize(activeNote.den)}`}>
                                <span>{activeNote.den}</span>
                                <span className="text-slate-600 font-normal">/</span>
                                <span>{activeNote.num}</span>
                            </div>
                            <div className="text-slate-500 mt-2 md:mt-3 font-mono text-xs md:text-sm bg-slate-950 px-2 py-1 rounded">
                                {(activeNote.den / activeNote.num * 100).toFixed(2)}% length
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    );
}