                                        <td class="p-4 text-slate-800 font-semibold bg-amber-50/30">Postulates & Common Notions</td>
                                    </tr>
                                    <tr class="border-b border-slate-100 hover:bg-slate-50 transition-colors">
                                        <td class="p-4 text-slate-700 font-medium border-r border-slate-200"><i class="fa-solid fa-bolt text-slate-400 mr-2 w-4"></i> Demonstrations</td>
                                        <td class="p-4 text-slate-800 font-semibold bg-amber-50/30">Proofs</td>
                                    </tr>
                                    <tr class="border-b border-slate-100 hover:bg-slate-50 transition-colors">
                                        <td class="p-4 text-slate-700 font-medium border-r border-slate-200"><i class="fa-solid fa-link text-slate-400 mr-2 w-4"></i> Logical deduction</td>
                                        <td class="p-4 text-slate-800 font-semibold bg-amber-50/30">Geometric deduction</td>
                                    </tr>
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="p-4 text-slate-700 font-medium border-r border-slate-200"><i class="fa-solid fa-sitemap text-slate-400 mr-2 w-4"></i> Scientific system</td>
                                        <td class="p-4 text-slate-800 font-bold text-classic-gold bg-amber-50/50">Complete geometric system</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="bg-classic-900 text-white p-6 rounded-xl shadow-lg">
                            <h3 class="font-serif text-xl font-bold mb-3 flex items-center gap-2">
                                <i class="fa-solid fa-lightbulb text-classic-gold"></i> The Grand Conclusion
                            </h3>
                            <p class="text-slate-300 mb-4 text-sm leading-relaxed">
                                Euclid begins Book I with exactly the sequence Aristotle recommended. What Euclid borrowed was the axiomatic structure, deductive organization, importance of definitions, scientific rigor, and the concept of proof as the absolute basis of knowledge.
                            </p>
                            <div class="flex items-center gap-2 text-classic-gold font-bold bg-black/30 p-3 rounded-lg border border-slate-700 justify-center">
                                Definitions <i class="fa-solid fa-arrow-right text-xs mx-1"></i> Common Notions <i class="fa-solid fa-arrow-right text-xs mx-1"></i> Postulates <i class="fa-solid fa-arrow-right text-xs mx-1"></i> Propositions
                            </div>
                        </div>
                    </div>
                `
            }
        ];

        const navContainer = document.getElementById('nav-tabs');
        const contentContainer = document.getElementById('main-content');
        let activeTabId = contentData[0].id;

        function renderApp() {
            // Render Navigation
            navContainer.innerHTML = '';
            contentData.forEach(item => {
                const li = document.createElement('li');
                li.className = 'flex-shrink-0';

                const btn = document.createElement('button');
                btn.onclick = () => setActiveTab(item.id);
                btn.className = `w-full text-left px-6 py-4 flex items-center gap-3 transition-all duration-200 outline-none ${item.id === activeTabId ? 'tab-active' : 'tab-inactive'
                    }`;

                btn.innerHTML = `
                    <i class="fa-solid ${item.icon} w-5 text-center ${item.id === activeTabId ? 'text-classic-gold' : ''}"></i>
                    <span class="whitespace-nowrap md:whitespace-normal text-sm md:text-base">${item.title}</span>
                `;

                li.appendChild(btn);
                navContainer.appendChild(li);
            });

            // Render Content
            contentContainer.innerHTML = '';
            contentData.forEach(item => {
                const div = document.createElement('div');
                div.id = `content-${item.id}`;
                div.className = `section-content pb-20 md:pb-0 max-w-4xl mx-auto ${item.id === activeTabId ? 'active' : ''}`;
                div.innerHTML = item.content;
                contentContainer.appendChild(div);
            });
        }

        function setActiveTab(id) {
            activeTabId = id;
            renderApp();
        }

        function runSyllogism() {
            const btn = document.getElementById('btn-deduce');
            const p2 = document.getElementById('premise2');
            const arrow = document.getElementById('logic-arrow');
            const conc = document.getElementById('conclusion');

            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Deducing...';
            btn.classList.replace('bg-classic-gold', 'bg-slate-400');

            // Step 1: Reveal minor premise
            setTimeout(() => {
                p2.classList.remove('opacity-50');
                p2.classList.add('opacity-100', 'transform', 'translate-x-2');
            }, 600);

            // Step 2: Show arrow
            setTimeout(() => {
                arrow.classList.remove('opacity-50');
                arrow.classList.add('opacity-100', 'text-classic-gold');
            }, 1200);

            // Step 3: Reveal conclusion
            setTimeout(() => {
                conc.classList.remove('opacity-50');
                conc.classList.add('opacity-100', 'transform', 'scale-105');

                btn.innerHTML = 'Deduction Complete <i class="fa-solid fa-check ml-2"></i>';
                btn.classList.replace('bg-slate-400', 'bg-green-600');
            }, 1800);

            // Reset after a while
            setTimeout(() => {
                p2.classList.replace('opacity-100', 'opacity-50');
                p2.classList.remove('transform', 'translate-x-2');
                arrow.classList.replace('opacity-100', 'opacity-50');
                arrow.classList.remove('text-classic-gold');
                conc.classList.replace('opacity-100', 'opacity-50');
                conc.classList.remove('transform', 'scale-105');

                btn.disabled = false;
                btn.innerHTML = 'Perform Deduction <i class="fa-solid fa-wand-magic-sparkles ml-2"></i>';
                btn.classList.replace('bg-green-600', 'bg-classic-gold');
            }, 5000);
        }

        // Initialize App
        document.addEventListener('DOMContentLoaded', renderApp);
    </script>
</body>

</html>